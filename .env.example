# ==============================================================================
# Hermes Business Agent - Unified Production Environment Configuration
# Copy this file to .env (or ~/.hermes/.env) and fill in your credentials.
# NEVER commit real credentials, secrets, or API keys to git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Primary AI Model Provider (Azure Foundry / OpenAI)
# ------------------------------------------------------------------------------
AZURE_FOUNDRY_API_KEY=
AZURE_FOUNDRY_BASE_URL=https://<your-resource>.openai.azure.com/openai/v1
# Default model name (e.g. gpt-5.6-luna, gpt-4o, claude-3-5-sonnet)
DEFAULT_MODEL=gpt-5.6-luna

# ------------------------------------------------------------------------------
# 2. Telegram Bot Gateway & Access Control
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram numeric user IDs, or * for all
TELEGRAM_ALLOWED_USERS=*
TELEGRAM_ALLOW_ALL_USERS=true
GATEWAY_ALLOW_ALL_USERS=true

# ------------------------------------------------------------------------------
# 3. Web Search & Research Intelligence (Tavily)
# ------------------------------------------------------------------------------
TAVILY_API_KEY=

# ------------------------------------------------------------------------------
# 4. Google Workspace Multi-User Suite (Gmail & Calendar via Composio)
# ------------------------------------------------------------------------------
COMPOSIO_API_KEY=

# ------------------------------------------------------------------------------
# 5. Azure AI Search & Knowledge Base (RAG)
# ------------------------------------------------------------------------------
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_LAYOUT_CONTAINER=knowledge-layout
AZURE_STORAGE_TEXT_CONTAINER=knowledge-text
AZURE_STORAGE_IMAGE_CONTAINER=knowledge-images

AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_INDEX=knowledge-chunks
AZURE_SEARCH_LAYOUT_INDEXER=knowledge-layout-indexer
AZURE_SEARCH_TEXT_INDEXER=knowledge-text-indexer
AZURE_SEARCH_IMAGE_INDEXER=knowledge-image-indexer

AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_MULTIMODAL_DEPLOYMENT=

# Keep false to avoid Azure Cognitive Services free-tier quota throttling
HERMES_IMAGE_INDEXER=false

# ------------------------------------------------------------------------------
# 6. Media & File Deliverables Retention Policy
# ------------------------------------------------------------------------------
# Cache retention in hours (2160 = 90 days; 0 = permanent)
HERMES_MEDIA_CACHE_MAX_AGE_HOURS=2160
# Path where permanent user uploads are stored
HERMES_PERMANENT_UPLOADS_DIR=

# ------------------------------------------------------------------------------
# 7. Hermes Runtime Path & Plugin Discovery
# ------------------------------------------------------------------------------
# Path to the deployed src directory (auto-set by deploy_vm.sh)
HERMES_PROJECT_SRC=
HERMES_ENABLE_PROJECT_PLUGINS=1
