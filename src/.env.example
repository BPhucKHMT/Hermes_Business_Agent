AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_LAYOUT_CONTAINER=knowledge-layout
AZURE_STORAGE_TEXT_CONTAINER=knowledge-text
AZURE_STORAGE_IMAGE_CONTAINER=knowledge-images
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_ADMIN_KEY=
AZURE_SEARCH_QUERY_KEY=
AZURE_SEARCH_INDEX=knowledge-chunks
AZURE_SEARCH_LAYOUT_INDEXER=knowledge-layout-indexer
AZURE_SEARCH_TEXT_INDEXER=knowledge-text-indexer
AZURE_SEARCH_IMAGE_INDEXER=knowledge-image-indexer
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536
AZURE_OPENAI_MULTIMODAL_DEPLOYMENT=

# Disable image indexer to avoid Azure quota throttling. Set false to skip image uploads/indexing. Default: true
HERMES_IMAGE_INDEXER=false

# Read-only Gmail connector. OAuth client secret stays in Key Vault.
AZURE_KEY_VAULT_URL=
EMAIL_GOOGLE_CLIENT_ID=
EMAIL_GOOGLE_CLIENT_SECRET_REF=keyvault://email-google-client-secret
EMAIL_OAUTH_REDIRECT_URI=https://example.invalid/gmail/oauth/callback
EMAIL_CONNECTOR_SHARED_SECRET=
EMAIL_STATE_DB_PATH=
EMAIL_OPERATOR_USER_IDS=

# Web Search & Research Intelligence (Tavily)
TAVILY_API_KEY=

# Telegram Gateway & Multi-User Access
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USERS=
TELEGRAM_ALLOW_ALL_USERS=false

# Media & Upload Retention (in hours. Default 2160 = 90 days; 0 = permanent)
HERMES_MEDIA_CACHE_MAX_AGE_HOURS=2160
